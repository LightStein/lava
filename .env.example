# Copy to .env (never commit .env). docker compose reads it automatically.
# Generate the keys with:  node scripts/vapid-keys.mjs   (or: docker compose run --rm --no-deps api node scripts/vapid-keys.mjs)
LAVA_VAPID_PUBLIC=
LAVA_VAPID_PRIVATE=
LAVA_VAPID_SUBJECT=mailto:admin@example.com

# Where things are on the host (defaults shown)
LAVA_CONFIG_FILE=./lava.config.example.json
LAVA_INPUTS=./examples/inputs
LAVA_BIND=127.0.0.1
LAVA_HOST_PORT=8080
